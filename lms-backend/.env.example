# ==============================================================================
# QALMS BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development

# Server Ports
HTTP_PORT=8080
HTTPS_PORT=8443
LMS_API_URL=http://localhost:8080

# Database Configuration (Development / Testing)
DB_USER=root
DB_PASSWORD=alisher.1
DB_NAME=LMSystem
DB_HOST=127.0.0.1

# Database Configuration (Production - used when NODE_ENV=production)
DB_USER_PROD=lmsuser
DB_PASSWORD_PROD=your_strong_production_password

# Authentication & Security
JWT_SECRET=your_jwt_super_secret_key_change_in_production
ALLOW_AUTO_ADMIN_CREATION=false

# Calling App (MiroTalk SFU Video Class Integration)
CALLING_APP_URL=http://localhost:3010
CALLING_APP_API_URL=http://localhost:3010
CALLING_APP_API_SECRET=your_calling_app_api_secret_must_match_calling_app

# CORS Allowed Origins
CORS_ORIGIN_DEV=http://localhost:3000
CORS_ORIGIN_PROD=https://yourdomain.com

# SSL Certificate Paths (Production HTTPS only)
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ==============================================================================
# AI MODERATION & LIVE CLASS MONITORING SERVICE
# ==============================================================================
# URL of the Python AI Moderation Service
AI_MODERATION_URL=http://localhost:8000

# Enable/disable AI Moderation in real-time chat & classes ('true' | 'false')
AI_MODERATION_ENABLED=true

# Webhook secret shared between AI Voice Service and LMS Backend
LMS_WEBHOOK_SECRET=qalms_ai_webhook_secret_key
