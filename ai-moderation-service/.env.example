# Speech model. First run downloads it from Hugging Face (needs internet on your laptop).
# Urdu needs large-v3-turbo or large-v3. small / base are unusable for Urdu.
# For a quick English-only functional test on a slow laptop use: small.en
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_COMPUTE=int8         # cpu: int8 | gpu: float16
WHISPER_THREADS=4
# Language: auto (restricted to English/Urdu) | en | ur
LANG_MODE=auto
# Transcriber: whisper | scripted (tests only)
ASR_BACKEND=whisper
# Alerts below this confidence are logged but get no clip and no admin alert
ALERT_THRESHOLD=0.75
# Clip: total length and minimum padding before/after the incident (seconds)
CLIP_TOTAL_S=15
CLIP_MIN_PAD_S=3
# One alert per speaker and type inside this window (seconds)
COOLDOWN_S=30
# Keep every transcript so accuracy can be measured. Test app only.
STORE_ALL_TRANSCRIPTS=1
HOST=127.0.0.1
PORT=8000

# LMS Backend Integration
LMS_API_URL=http://localhost:8080
LMS_WEBHOOK_SECRET=qalms_ai_webhook_secret_key
AI_SERVICE_URL=http://localhost:8000
